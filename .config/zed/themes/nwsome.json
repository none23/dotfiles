{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "nwsome",
  "author": "Nick",
  "themes": [
    {
      "name": "nwsome",
      "appearance": "dark",
      "style": {
        "background": "#070707ff",
        "border": "#232323ff",
        "border.focused": "#de5e1eff",
        "border.selected": "#de5e1eff",
        "border.transparent": "#07070700",
        "border.variant": "#171717ff",
        "elevated_surface.background": "#232323ff",
        "surface.background": "#171717ff",
        "panel.background": "#070707ff",
        "panel.focused_border": "#de5e1eff",
        "panel.indent_guide": "#232323ff",
        "panel.indent_guide_active": "#777777ff",
        "panel.indent_guide_hover": "#555555ff",
        "pane.focused_border": "#de5e1eff",
        "pane_group.border": "#232323ff",

        "text": "#bbbbbbff",
        "text.muted": "#777777ff",
        "text.placeholder": "#555555ff",
        "text.disabled": "#333333ff",
        "text.accent": "#f58f15ff",
        "icon": "#999999ff",
        "icon.muted": "#555555ff",
        "icon.disabled": "#333333ff",
        "icon.placeholder": "#555555ff",
        "icon.accent": "#f58f15ff",

        "element.background": "#171717ff",
        "element.hover": "#232323ff",
        "element.active": "#330000ff",
        "element.selected": "#470000ff",
        "element.disabled": "#121212ff",
        "ghost_element.background": "#07070700",
        "ghost_element.hover": "#232323ff",
        "ghost_element.active": "#330000ff",
        "ghost_element.selected": "#470000ff",
        "ghost_element.disabled": "#121212ff",
        "drop_target.background": "#78000080",

        "title_bar.background": "#171717ff",
        "title_bar.inactive_background": "#070707ff",
        "toolbar.background": "#070707ff",
        "tab_bar.background": "#171717ff",
        "tab.active_background": "#232323ff",
        "tab.inactive_background": "#171717ff",
        "status_bar.background": "#232323ff",

        "scrollbar.track.background": "#07070700",
        "scrollbar.track.border": "#07070700",
        "scrollbar.thumb.background": "#55555580",
        "scrollbar.thumb.hover_background": "#777777aa",
        "scrollbar.thumb.border": "#07070700",

        "editor.foreground": "#bbbbbbff",
        "editor.background": "#070707ff",
        "editor.gutter.background": "#070707ff",
        "editor.subheader.background": "#171717ff",
        "editor.active_line.background": "#470000ff",
        "editor.highlighted_line.background": "#270300ff",
        "editor.line_number": "#de5e1eff",
        "editor.active_line_number": "#fefa00ff",
        "editor.invisible": "#555555ff",
        "editor.wrap_guide": "#780000ff",
        "editor.active_wrap_guide": "#966a00ff",
        "editor.indent_guide": "#232323ff",
        "editor.indent_guide_active": "#777777ff",
        "editor.document_highlight.read_background": "#55555555",
        "editor.document_highlight.write_background": "#78000088",
        "editor.document_highlight.bracket_background": "#966a00cc",
        "search.match_background": "#77777799",

        "players": [
          {
            "cursor": "#666666ff",
            "background": "#666666ff",
            "selection": "#ff660066"
          }
        ],

        "error": "#cc1300ff",
        "error.background": "#3a1014ff",
        "error.border": "#cc1300ff",
        "warning": "#fefa00ff",
        "warning.background": "#3a3216ff",
        "warning.border": "#fefa00ff",
        "info": "#999999ff",
        "info.background": "#232323ff",
        "info.border": "#777777ff",
        "hint": "#f58f15ff",
        "hint.background": "#270300ff",
        "hint.border": "#f58f15ff",
        "success": "#5afe2eff",
        "success.background": "#0f3a1dff",
        "success.border": "#5afe2eff",

        "created": "#5afe2eff",
        "created.background": "#0f3a1dff",
        "created.border": "#5afe2eff",
        "modified": "#de5e1eff",
        "modified.background": "#3a3216ff",
        "modified.border": "#de5e1eff",
        "deleted": "#cc1300ff",
        "deleted.background": "#3a1014ff",
        "deleted.border": "#cc1300ff",
        "renamed": "#f58f15ff",
        "renamed.background": "#270300ff",
        "renamed.border": "#f58f15ff",
        "conflict": "#fefa00ff",
        "conflict.background": "#3a3216ff",
        "conflict.border": "#fefa00ff",
        "ignored": "#555555ff",
        "ignored.background": "#171717ff",
        "ignored.border": "#333333ff",
        "hidden": "#333333ff",
        "hidden.background": "#070707ff",
        "hidden.border": "#171717ff",
        "unreachable": "#555555ff",
        "unreachable.background": "#171717ff",
        "unreachable.border": "#333333ff",
        "predictive": "#555555ff",
        "predictive.background": "#171717ff",
        "predictive.border": "#333333ff",

        "terminal.background": "#070707ff",
        "terminal.foreground": "#bbbbbbff",
        "terminal.bright_foreground": "#ffffffff",
        "terminal.dim_foreground": "#777777ff",
        "terminal.ansi.background": "#070707ff",
        "terminal.ansi.black": "#070707ff",
        "terminal.ansi.red": "#cc1300ff",
        "terminal.ansi.green": "#5afe2eff",
        "terminal.ansi.yellow": "#fefa00ff",
        "terminal.ansi.blue": "#777777ff",
        "terminal.ansi.magenta": "#c7aed9ff",
        "terminal.ansi.cyan": "#999999ff",
        "terminal.ansi.white": "#bbbbbbff",
        "terminal.ansi.bright_black": "#555555ff",
        "terminal.ansi.bright_red": "#ff541eff",
        "terminal.ansi.bright_green": "#defa11ff",
        "terminal.ansi.bright_yellow": "#ffaa55ff",
        "terminal.ansi.bright_blue": "#999999ff",
        "terminal.ansi.bright_magenta": "#c7aed9ff",
        "terminal.ansi.bright_cyan": "#bbbbbbff",
        "terminal.ansi.bright_white": "#ffffffff",

        "syntax": {
          "attribute": { "color": "#f58f15ff" },
          "boolean": { "color": "#fefa00ff" },
          "comment": { "color": "#555555ff" },
          "comment.doc": { "color": "#777777ff" },
          "constant": { "color": "#de5e1eff" },
          "constructor": { "color": "#fefa00ff" },
          "embedded": { "color": "#bbbbbbff" },
          "emphasis": { "color": "#f58f15ff", "font_style": "italic" },
          "emphasis.strong": { "color": "#f58f15ff", "font_weight": 700 },
          "enum": { "color": "#bbbbbbff" },
          "function": { "color": "#fefa00ff" },
          "function.method": { "color": "#fefa00ff" },
          "keyword": { "color": "#bbbbbbff" },
          "label": { "color": "#bbbbbbff" },
          "link_text": { "color": "#f58f15ff" },
          "link_uri": { "color": "#999999ff" },
          "number": { "color": "#be3300ff" },
          "operator": { "color": "#777777ff" },
          "predictive": { "color": "#555555ff", "font_style": "italic" },
          "preproc": { "color": "#bbbbbbff" },
          "primary": { "color": "#bbbbbbff" },
          "property": { "color": "#cf2300ff" },
          "punctuation": { "color": "#f58f15ff" },
          "punctuation.bracket": { "color": "#f58f15ff" },
          "punctuation.delimiter": { "color": "#f58f15ff" },
          "punctuation.list_marker": { "color": "#de5e1eff" },
          "punctuation.special": { "color": "#f58f15ff" },
          "selector": { "color": "#de5e1eff" },
          "selector.pseudo": { "color": "#f58f15ff" },
          "string": { "color": "#fe5e1eff" },
          "string.escape": { "color": "#f58f15ff" },
          "string.regex": { "color": "#ff541eff" },
          "string.special": { "color": "#f58f15ff" },
          "tag": { "color": "#f58f15ff" },
          "text.literal": { "color": "#fe5e1eff" },
          "title": { "color": "#c7aed9ff" },
          "type": { "color": "#bbbbbbff" },
          "variable": { "color": "#cf2300ff" },
          "variable.parameter": { "color": "#de5e1eff" },
          "variant": { "color": "#de5e1eff" }
        }
      }
    }
  ]
}
